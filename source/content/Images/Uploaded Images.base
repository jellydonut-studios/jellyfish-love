views:
  - type: cards
    name: Image View
    filters:
      and:
        - file.ext == "png"
    order:
      - file.name
      - file.tags
    sort:
      - property: file.name
        direction: ASC
      - property: file.ctime
        direction: ASC
    cardSize: 240
    image: file.file
  - type: cards
    name: Character View
    filters:
      and:
        - file.name.contains("_METADATA")
    order:
      - file.name
      - file.tags
    image: file.file
